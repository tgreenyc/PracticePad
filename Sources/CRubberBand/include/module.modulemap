// Exposes Rubber Band Library's C API (rubberband-c.h) to Swift as the
// `CRubberBand` module. The actual library is provided by the system
// (installed via Homebrew: `brew install rubberband`); this target only
// carries the module map. Include and link flags are supplied by the
// PracticePad target in Package.swift.
module CRubberBand {
    header "shim.h"
    link "rubberband"
    export *
}
